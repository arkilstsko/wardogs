{
  "name": "wardogs",
  "version": "1.0.0-playtest",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "simulate": "node --import tsx tools/simulate/run.ts",
    "server": "node --import tsx apps/server/src/index.ts",
    "e2e": "playwright test",
    "format:check": "prettier --check packages/game-core/src/v1 packages/game-core/tests/v1*.ts apps/server/src/v1*.ts apps/server/tests/v1*.ts apps/web/src/v1 apps/web/src/style.css tests/e2e/v1.spec.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@noble/hashes": "2.4.0",
    "idb": "^8.0.3",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "fast-check": "^4.3.0",
    "prettier": "3.8.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
